# Environment Variables Configuration

# Server Port
PORT=5000

# MongoDB URI (For local dev: mongodb://127.0.0.1:27017/webscraper | Docker: mongodb://mongodb:27017/webscraper)
MONGODB_URI=mongodb://127.0.0.1:27017/webscraper

# Frontend API Target (Vite client)
VITE_API_URL=http://localhost:5000/api
